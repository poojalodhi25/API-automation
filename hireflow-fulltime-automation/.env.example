# Copy this file to .env and fill in your local values.
# Do not commit .env.

APP_NAME=HireFlow Full-Time Automation
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=hireflow_fulltime

# Gemini (resume alignment + email wording)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Gmail API OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback
GMAIL_SENDER_EMAIL=
GMAIL_CC_EMAIL=
GMAIL_BCC_EMAIL=

# USAJobs (https://developer.usajobs.gov/)
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=HireFlow/1.0 (your_email@example.com)

# Optional extra job API
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

FOLLOWUP_AFTER_DAYS=7
EMAIL_SEND_DELAY_SECONDS=3
